{
  "name": "yuning-peng-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev --host 127.0.0.1 --port 4321",
    "build": "node node_modules/astro/bin/astro.mjs check && node node_modules/astro/bin/astro.mjs build",
    "preview": "node node_modules/astro/bin/astro.mjs preview --host 127.0.0.1 --port 4321",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check:assets": "node scripts/check_web_assets.mjs",
    "dev:background": "node node_modules/astro/bin/astro.mjs dev --host 127.0.0.1 --port 4321 --background",
    "dev:status": "node node_modules/astro/bin/astro.mjs dev status",
    "dev:stop": "node node_modules/astro/bin/astro.mjs dev stop",
    "dev:logs": "node node_modules/astro/bin/astro.mjs dev logs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests scripts/*.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@fontsource/montserrat": "^5.2.0",
    "@fontsource/space-mono": "^5.2.0",
    "@sparkjsdev/spark": "2.2.0",
    "astro": "7.3.3",
    "motion": "13.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.180.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^5.9.0"
  }
}
